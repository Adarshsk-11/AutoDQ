# Copy this file to .env and adjust as needed. All values below are the
# defaults used if the variable is unset, so a fresh checkout works with
# no .env file at all -- this file exists for when you need to change one.

# Comma-separated list of origins allowed to call the API (CORS).
#
# Left commented out by default so a fresh checkout is never accidentally
# LESS permissive than intended: with no value set, the backend allows all
# origins ("*"), which is what you want for local development. Vite can
# silently pick a different port than 5173 if that port is already in use
# on your machine (5174, 5175, ...) -- if you uncomment and hardcode a
# specific origin list here, make sure it actually matches the port your
# frontend is really running on (check the terminal output from `npm run
# dev`), or requests will fail with a CORS error that looks identical to
# "the backend isn't running" even though it is.
#
# Uncomment and restrict this before any real deployment:
# ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Maximum accepted upload size, in megabytes.
MAX_FILE_SIZE_MB=50

# Host/port uvicorn binds to when run via `python -m app.main` directly
# (not needed if you start it with `uvicorn app.main:app --reload`, which
# takes host/port as CLI flags instead).
HOST=0.0.0.0
PORT=8000
